{
  "annotations": { "list": [] },
  "editable": true,
  "title": "Ignoa API | Overview",
  "uid": "ignoa-api",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "panels": [
    {
      "title": "API | 전체 요청량",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "description": "Actuator를 제외한 전체 API의 초당 요청 수다.",
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15 } } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"ignoa-api\", uri!~\"/actuator.*\"}[1m]))", "legendFormat": "requests/s", "refId": "A" }
      ]
    },
    {
      "title": "API | 전체 HTTP 응답 시간 p95",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"ignoa-api\", uri!~\"/actuator.*\"}[1m])) by (le))", "legendFormat": "all API p95", "refId": "A" }
      ]
    },
    {
      "title": "API | HTTP 5xx 오류",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "description": "초당 5xx 응답 수다. 오류가 없으면 0으로 표시한다.",
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20 } } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"ignoa-api\", status=~\"5..\"}[1m])) or vector(0)", "legendFormat": "5xx/s", "refId": "A" }
      ]
    },
    {
      "title": "시스템 | HikariCP 커넥션",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15 } } },
      "targets": [
        { "expr": "hikaricp_connections_active{application=\"ignoa-api\"}", "legendFormat": "active", "refId": "A" },
        { "expr": "hikaricp_connections_pending{application=\"ignoa-api\"}", "legendFormat": "pending", "refId": "B" },
        { "expr": "hikaricp_connections_idle{application=\"ignoa-api\"}", "legendFormat": "idle", "refId": "C" }
      ]
    },
    {
      "title": "시스템 | Tomcat 스레드",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15 } } },
      "targets": [
        { "expr": "tomcat_threads_busy_threads{application=\"ignoa-api\"}", "legendFormat": "busy", "refId": "A" },
        { "expr": "tomcat_threads_current_threads{application=\"ignoa-api\"}", "legendFormat": "current", "refId": "B" },
        { "expr": "tomcat_threads_config_max_threads{application=\"ignoa-api\"}", "legendFormat": "max", "refId": "C" }
      ]
    },
    {
      "title": "시스템 | CPU 사용률",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "expr": "process_cpu_usage{application=\"ignoa-api\"}", "legendFormat": "app process", "refId": "A" },
        { "expr": "system_cpu_usage{application=\"ignoa-api\"}", "legendFormat": "system", "refId": "B" }
      ]
    }
  ]
}
